{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Old Converter",
  "version": "1.0.0",
  "identifier": "com.oldconverter.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Old Converter",
        "width": 980,
        "height": 720,
        "minWidth": 860,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Make your videos feel old again.",
    "longDescription": "Old Converter turns modern videos into 2015-2017 style uploads using real FFmpeg conversion.",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "resources": ["../ffmpeg/**/*", "../presets/**/*"]
  }
}
